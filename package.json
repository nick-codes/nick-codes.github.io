{
  "name": "nick-codes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "nick.codes \u2014 fractional CTO and principal engineer for hire.",
  "scripts": {
    "content": "node tools/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build",
    "postbuild": "node tools/post-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build && gh-pages --dist dist --branch gh-pages --dotfiles --nojekyll --message \"Deploy site build\"",
    "claude": "docker-compose run claude",
    "claude:build": "docker-compose run --build claude",
    "deploy:dry": "npm run build && echo \"--- dist/ contents ---\" && ls -R dist"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.7"
  }
}
